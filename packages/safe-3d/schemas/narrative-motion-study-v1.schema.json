{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://balisong-atlas.local/schemas/narrative-motion-study-v1.schema.json",
  "title": "NarrativeMotionStudyV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "title", "interpretation_scope", "evidence_state", "source_record_ids", "visual_cues", "safety_constraints"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "study_id": { "type": "string", "minLength": 1 },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "zh": { "type": "string", "minLength": 1 }
      }
    },
    "interpretation_scope": { "const": "media_representation" },
    "evidence_state": { "enum": ["proposed", "accepted"] },
    "source_record_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "visual_cues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cue_id", "cue_type", "description", "evidence_ids"],
        "properties": {
          "cue_id": { "type": "string", "minLength": 1 },
          "cue_type": { "enum": ["circulation", "attention", "uncertainty"] },
          "description": { "type": "string", "minLength": 1 },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    },
    "safety_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["joined_proxy_only", "scene_camera_motion_only", "no_part_motion", "no_joint_motion", "no_operational_sequence", "no_frame_breakdown", "no_angles_or_speed", "no_grip_guidance"],
      "properties": {
        "joined_proxy_only": { "const": true },
        "scene_camera_motion_only": { "const": true },
        "no_part_motion": { "const": true },
        "no_joint_motion": { "const": true },
        "no_operational_sequence": { "const": true },
        "no_frame_breakdown": { "const": true },
        "no_angles_or_speed": { "const": true },
        "no_grip_guidance": { "const": true }
      }
    }
  }
}

